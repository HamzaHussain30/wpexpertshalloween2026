{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wpexpertshalloween2026",
  "compatibility_date": "2026-10-06",
  // static export from `next build` (output: "export")
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
